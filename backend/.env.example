# ---------------------------------------------------------------------------
# Legal AI backend — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Core ---
APP_NAME="Legal AI"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+asyncpg://legalai:legalai@localhost:5432/legalai
DATABASE_URL_SYNC=postgresql+psycopg2://legalai:legalai@localhost:5432/legalai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_FALLBACK_TO_DB=false

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT_PER_WINDOW=3
OTP_RESEND_WINDOW_MINUTES=15

# --- LLM / RAG ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
MIN_SIMILARITY=0.35
RETRIEVAL_TOP_K=8
VECTOR_BACKEND=pgvector
FREE_QUESTIONS_PER_DAY=20

# --- Payments (generic) ---
PAYMENT_ENABLED_METHODS=BKASH,NAGAD,SSLCOMMERZ,MOCK
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_PENDING_TIMEOUT_MINUTES=1440
PLATFORM_COMMISSION_PERCENT=20
CANCELLATION_FULL_REFUND_WINDOW_HOURS=24

# --- bKash Tokenized Checkout ---
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# --- Nagad Online Payment ---
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback/nagad
NAGAD_MERCHANT_PRIVATE_KEY_B64=
NAGAD_PG_PUBLIC_KEY_B64=

# --- SSLCommerz ---
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_BASE_URL=https://sandbox.sslcommerz.com

# --- Video (LiveKit / Jitsi) ---
VIDEO_PROVIDER=livekit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_APP_SECRET=

# --- Email ---
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@legalai.local
SMTP_USE_TLS=true

# --- SMS ---
SMS_PROVIDER=console
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=LegalAI

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=300

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png

# --- Rate limiting (per user unless noted) ---
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PAYMENT_INITIATIONS_PER_WINDOW=5
RATE_LIMIT_PAYMENT_WINDOW_MINUTES=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Manual wallet payments (Send Money numbers shown to citizens; empty = hidden) ---
MANUAL_PAYMENT_BKASH_NUMBER=
MANUAL_PAYMENT_NAGAD_NUMBER=
MANUAL_PAYMENT_ROCKET_NUMBER=

# --- Admins (apply with: python -m scripts.set_admins) ---
ADMIN_EMAILS=
