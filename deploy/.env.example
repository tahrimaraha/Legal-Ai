# Copy to deploy/.env on the server and fill in.   cp .env.example .env && nano .env
# NEVER commit deploy/.env — it holds passwords.

# Web address of the site, without https://
#   free:   legalai-<SERVER-IP-WITH-DASHES>.sslip.io     e.g. legalai-203-0-113-5.sslip.io
#   domain: legalai.example.com
SITE_ADDRESS=legalai-203-0-113-5.sslip.io

# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
TURN_PASSWORD=

# Email (Gmail app password — same values as backend/.env on your computer)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LEGAL AI
SMTP_USE_TLS=true

# Optional: Gemini rewrites answers in friendlier wording (citations always come from the corpus)
GEMINI_API_KEY=
